-    uint64_t pb = g_Entries[i].PeBase;
-    uint64_t sz = g_Entries[i].Size;
-    if (Addr >= pb && Addr < pb + sz) {
-      return g_Entries[i].JitBase + (Addr - pb);
+  const unsigned Index = ((Addr >> 16) ^ (Addr >> 28)) & 255;
+  auto Entry = __atomic_load_n(&IosAliasForwardCache[Index], __ATOMIC_RELAXED);
+  if (Entry && Addr - Entry->PeBase < Entry->Size) return Entry->JitBase + (Addr - Entry->PeBase);
+  for (int I = g_EntryCount; I-- > 0;) {
+    auto* Candidate = &g_Entries[I];
+    if (Addr - Candidate->PeBase < Candidate->Size) {
+      __atomic_store_n(&IosAliasForwardCache[Index], Candidate, __ATOMIC_RELAXED);
+      return Candidate->JitBase + (Addr - Candidate->PeBase);
     }
   }
