@@ -21,14 +21,18 @@
 .arch_extension lse   // ml1131: stadd/ldadd for the transition probe counters
 // ml1131: add 1 to the sp-sharded counter at IosXpFex + \off. Clobbers \a, \b.
 .macro IOS_XP_COUNT off, a, b
+  // Plain load/add/store: the shard is selected by sp bits 16..19, so it is
+  // effectively thread-private and the (rare) cross-thread collision only
+  // loses a diagnostic count. An LSE atomic here cost a locked RMW per crossing.
   adrp \a, IosXpFex
   add \a, \a, #:lo12:IosXpFex
   mov \b, sp
   ubfx \b, \b, #16, #4
   add \a, \a, \b, lsl #6
   add \a, \a, #\off
-  mov \b, #1
-  stadd \b, [\a]
+  ldr \b, [\a]
+  add \b, \b, #1
+  str \b, [\a]
 .endm
