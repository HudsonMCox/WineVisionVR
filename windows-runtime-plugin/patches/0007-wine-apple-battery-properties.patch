+/* IOPS descriptions belong to the blob and may omit desktop-only properties. */
+static BOOL apple_battery_number( CFDictionaryRef source, CFStringRef key, int32_t *value )
+{
+    CFTypeRef prop = CFDictionaryGetValue( source, key );
+    return prop && CFGetTypeID( prop ) == CFNumberGetTypeID() &&
+           CFNumberGetValue( prop, kCFNumberIntType, value );
