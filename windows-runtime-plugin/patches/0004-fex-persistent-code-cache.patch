+// Full source bytes invalidate caches even when a publisher preserves PE metadata.
+static uint64_t SourceHash(const fextl::string& Filename) {
+  std::string Path(Filename.c_str());
+  if (Path.starts_with("\\??\\")) Path.erase(0, 4);
+  std::ifstream File(Path, std::ios::binary);
+  if (!File) return 0;
+  auto State = XXH3_createState();
+  if (!State) return 0;
+  XXH3_64bits_reset(State);
+  char Buffer[65536];
+  while (File.read(Buffer, sizeof(Buffer)) || File.gcount()) XXH3_64bits_update(State, Buffer, File.gcount());
+  auto Hash = File.bad() ? 0 : XXH3_64bits_digest(State);
+  XXH3_freeState(State);
+  return Hash;
+}
+
+// Validate the complete layout before allocating or dereferencing variable counts.
+static bool ValidateCacheLayout(std::span<const std::byte> File, const CodeCacheHeader& H) {
+  size_t Cursor = sizeof(H);
+  auto Skip = [&](uint64_t N, size_t Unit) {
+    if (N > (File.size() - Cursor) / Unit) return false;
+    Cursor += N * Unit; return true;
+  };
+  auto Read = [&](uint64_t& Value) {
+    if (!Skip(1, 8)) return false;
+    memcpy(&Value, File.data() + Cursor - 8, 8); return true;
+  };
+  if (File.size() < sizeof(H) || H.FormatVersion != 3 || !H.NumBlocks ||
+      !H.CodeBufferSize || H.CodeBufferSize > 96 * 1024 * 1024 || H.CodeBufferSize % 4096 ||
+      H.NumBlocks > 1000000 || H.NumCodePages > 1000000) return false;
+  uint64_t LastGuest = 0;
+  for (uint32_t I = 0; I < H.NumBlocks; ++I) {
+    uint64_t Guest, Host, Pages;
+    if (!Read(Guest) || !Read(Host) || !Read(Pages) || !Pages ||
+        Guest > UINT32_MAX || (I && Guest <= LastGuest) || Host >= H.CodeBufferSize || Host % 4 || !Skip(Pages, 8)) return false;
+    LastGuest = Guest;
+  }
+  uint64_t LastOffset = 0;
+  for (uint32_t I = 0; I < H.NumRelocations; ++I) {
+    if (!Skip(1, sizeof(CPU::Relocation))) return false;
+    CPU::Relocation R;
+    memcpy(&R, File.data() + Cursor - sizeof(R), sizeof(R));
+    auto Type = static_cast<uint32_t>(R.Header.Type);
+    auto Bytes = (Type == 0 || Type == 2) ? 8U : 16U;
+    if (Type > 3 || R.Header.Offset > H.CodeBufferSize - Bytes || (I && R.Header.Offset < LastOffset) ||
+        (Type == 0 && static_cast<uint32_t>(R.NamedSymbolLiteral.Symbol) != 0) ||
+        (Type == 1) ||
+        (Type == 3 && R.GuestRIP.RegisterIndex > 30)) return false;
+    LastOffset = R.Header.Offset;
+  }
+  Cursor = AlignUp(Cursor, 4096);
+  if (Cursor > File.size() || !Skip(H.CodeBufferSize, 1)) return false;
+  for (uint32_t I = 0; I < H.NumCodePages; ++I) {
+    uint64_t Page, Entries;
+    if (!Read(Page) || Page > UINT32_MAX || Page % 4096 || !Read(Entries) || !Skip(Entries, 8)) return false;
+  }
+  // NtMapView rounds the final page up; trailing mapped padding is not hashed.
+  if (Cursor > File.size() || H.padding != Cursor || H.padding < sizeof(H)) return false;
+  return XXH3_64bits(File.data() + sizeof(H), Cursor - sizeof(H)) == H.PayloadHash;
+}
+
+bool IsPersistentCacheCurrent(const char* Filename, const char* SourceFilename) {
+  std::ifstream File(Filename, std::ios::binary | std::ios::ate);
+  if (!File) return false;
+  auto Size = File.tellg();
+  if (Size < static_cast<std::streamoff>(sizeof(CodeCacheHeader)) || Size > 128 * 1024 * 1024) return false;
+  fextl::vector<std::byte> Data(static_cast<size_t>(Size));
+  File.seekg(0); if (!File.read(reinterpret_cast<char*>(Data.data()), Size)) return false;
+  CodeCacheHeader H; memcpy(&H, Data.data(), sizeof(H));
+  return std::ranges::equal(H.Magic, H.ExpectedMagic) && std::ranges::equal(H.FEXVersion, GIT_HASH) &&
+    ValidateCacheLayout(Data, H) && H.SourceHash && H.SourceHash == SourceHash(fextl::string(SourceFilename));
+}
 
