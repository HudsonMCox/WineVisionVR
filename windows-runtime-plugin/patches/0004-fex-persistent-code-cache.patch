+++ b/FEX/FEXCore/include/FEXCore/Config/CodeCacheIdentity.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Config/Config.h>
+#include <xxhash.h>
+namespace FEXCore {
+inline uint64_t CodeCacheConfigurationId() {
+  auto State = XXH3_createState();
+  if (!State) return 0;
+  XXH3_64bits_reset(State);
+  auto Add = [&](std::string_view Key, std::string_view Value) {
+    if (Key == "APP_FILENAME" || Key == "APP_CONFIG_NAME" || Key == "OUTPUTLOG" || Key == "SERVERSOCKETPATH") return;
+    XXH3_64bits_update(State, Key.data(), Key.size());
+    uint64_t Size = Value.size(); XXH3_64bits_update(State, &Size, sizeof(Size));
+    XXH3_64bits_update(State, Value.data(), Value.size());
+  };
+#define OPT_BASE(type, group, name, json, default) { Config::Getter<Config::CONFIG_##name> V; Add(#name, fmt::format("{}", V())); }
+#define OPT_STR(group, name, json, default) { Config::Getter<Config::CONFIG_##name> V; Add(#name, V()); }
+#define OPT_STRARRAY(group, name, json, default) { Config::Getter<Config::CONFIG_##name> V; for (auto& E : V.All()) Add(#name, E); }
+#include <FEXCore/Config/ConfigValues.inl>
+  auto Hash = XXH3_64bits_digest(State); XXH3_freeState(State); return Hash;
+}
+}
