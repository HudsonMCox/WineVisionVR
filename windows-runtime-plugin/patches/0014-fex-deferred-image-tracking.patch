+/* iOS-Madeira ml715: DEFERRED ImageTracker HALF OF NotifyImageMap.
+ *
+ * NotifyImageMap() can only register InvalidationTracker intervals (see its comment), so a
+ * module reaching FEX solely through that fallback never got ImageTracker processing:
+ * volatile metadata, ForceTSO metadata and code-cache image info were all missing, and
+ * every access in it paid full TSO emulation. NotifyImageMap therefore queues {base, path}
+ * here and DrainDeferredImageMaps() runs ImageTracker::HandleImageMap() later, from a
+ * callback that is NOT inside translated code.
+ *
+ * Why the drain is safe where NotifyImageMap is not: ImageTracker::HandleImageMap takes
+ * CodeInvalidationMutex EXCLUSIVE, which self-deadlocks if this thread holds it SHARED.
+ * Every shared acquisition (WritePriorityMutex::NoteReadAcquired) bumps a per-thread depth
+ * in TEB Instrumentation[7], and NotifyReadFile's exclusive pair sets Instrumentation[9],
+ * so the drain checks both and simply leaves the queue untouched when either is set --
+ * the hold is PROVEN absent at the point of use, not assumed. Drain points are the
+ * callbacks that already take ThreadCreationMutex and invalidate under the exclusive lock
+ * (NotifyMapViewOfSection, the instruction-cache flush/dirty callbacks) plus ThreadInit,
+ * which runs before the thread executes any translated code.
+ *
+ * Blocks compiled for the module before its metadata arrived keep full TSO (correct, just
+ * slower), so after applying metadata the module range is invalidated through the same
+ * InvalidateAlignedInterval used by the flush callbacks, letting it recompile with metadata.
+ *
+ * Fast path when nothing is pending: one relaxed atomic load. */
+struct DeferredImageMap {
+  uint64_t Address;
+  fextl::string ModulePath;
+};
+constexpr size_t MaxDeferredImageMaps = 64;
+std::mutex DeferredImageMapsLock;
+fextl::vector<DeferredImageMap> DeferredImageMaps;
+std::atomic<uint32_t> DeferredImageMapCount {0};
+
+void QueueDeferredImageMap(uint64_t Address, fextl::string ModulePath) {
+  if (ImageTracker && ImageTracker->IsImageTracked(Address)) {
+    return;
+  }
+
+  std::scoped_lock Lock(DeferredImageMapsLock);
+  for (const auto& Entry : DeferredImageMaps) {
+    if (Entry.Address == Address) {
+      return;
+    }
+  }
+  if (DeferredImageMaps.size() >= MaxDeferredImageMaps) {
+    static std::atomic<uint32_t> OverflowCount {0};
+    if (++OverflowCount <= 8) {
+      LogMan::Msg::EFmt("[img-map] ml715 deferred queue full, dropping base={:X} {}", Address, ModulePath);
+    }
+    return;
+  }
+  DeferredImageMaps.push_back({Address, std::move(ModulePath)});
+  DeferredImageMapCount.store(static_cast<uint32_t>(DeferredImageMaps.size()), std::memory_order_release);
+}
+
+// Caller holds ThreadCreationMutex. An unmapped image must never be processed later.
+void DropDeferredImageMaps(uint64_t Start, uint64_t Size) {
+  if (!DeferredImageMapCount.load(std::memory_order_relaxed)) {
+    return;
+  }
+
+  std::scoped_lock Lock(DeferredImageMapsLock);
+  std::erase_if(DeferredImageMaps, [&](const DeferredImageMap& Entry) { return Entry.Address >= Start && Entry.Address < Start + Size; });
+  DeferredImageMapCount.store(static_cast<uint32_t>(DeferredImageMaps.size()), std::memory_order_release);
+}
+
+bool ThreadMayHoldCodeInvalidationLock() {
+  const auto Teb = reinterpret_cast<uintptr_t>(NtCurrentTeb());
+  const uint32_t SharedDepth = *reinterpret_cast<volatile uint32_t*>(Teb + 0x16f0); // WritePriorityMutex shared-hold depth
+  const bool InLockedRWXRead = *reinterpret_cast<volatile bool*>(Teb + 0x1700);     // BTCpu64NotifyReadFile exclusive pair
+  return SharedDepth != 0 || InLockedRWXRead;
+}
+
+// Caller holds ThreadCreationMutex.
+void DrainDeferredImageMaps() {
+  if (!DeferredImageMapCount.load(std::memory_order_relaxed)) {
+    return;
+  }
+  if (!ContextCallbacksActive() || !InvalidationTracker || !ImageTracker || ThreadMayHoldCodeInvalidationLock()) {
+    return;
+  }
+
+  fextl::vector<DeferredImageMap> Pending;
+  {
+    std::scoped_lock Lock(DeferredImageMapsLock);
+    Pending.swap(DeferredImageMaps);
+    DeferredImageMapCount.store(0, std::memory_order_release);
+  }
+
+  static std::atomic<uint32_t> Count {0};
+  for (const auto& Entry : Pending) {
+    const auto Section = ImageTracker->HandleImageMap(Entry.ModulePath, Entry.Address, false);
+    if (GetCPUArea().ThreadState() && Section.EndVA > Section.BeginVA) {
+      InvalidationTracker->InvalidateAlignedInterval(Section.BeginVA, Section.EndVA - Section.BeginVA, false);
+    }
+
+    const auto N = ++Count;
+    if (N <= 64) {
+      LogMan::Msg::EFmt("[img-map] ml715 #{} deferred ImageTracker {} base={:X}", N, FEX::Windows::BaseName(Entry.ModulePath), Entry.Address);
+    }
+  }
+}
