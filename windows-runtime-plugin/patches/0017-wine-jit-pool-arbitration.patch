  * reach; (size_t)-1 anchor = unconstrained (old behavior). */
+/* Head and fresh-tail reservations share ios_pool_lock. A caller may have
+ * computed its head limit before blocking on that lock, so re-clamp the limit
+ * at the commit point. A failed reservation never moves either cursor. */
+static size_t ios_pool_head_limit_locked( size_t requested_limit )
+{
+    size_t total = ios_jit_pool_size_global, tail = ios_jit_tail_reserved;
+    size_t live_limit = tail <= total ? total - tail : 0;
+    return requested_limit < live_limit ? requested_limit : live_limit;
+}
+
+static int ios_pool_reserve_tail_locked( size_t size, size_t *offset )
+{
+    size_t total = ios_jit_pool_size_global;
+    size_t head = jit_pool_offset, tail = ios_jit_tail_reserved;
+    /* Ten percent of the existing arena (64 MiB for the 640 MiB visionOS
+     * pool) stays available for DLLs loaded after FEX creates its code buffer.
+     * This replaces the old 48 MiB advisory cap, whose 16 MiB floor could
+     * consume that reserve even when calculated room was zero. */
+    size_t head_reserve = total / 10;
+    if (!size || head > total || tail > total - head) return 0;
+    if (head_reserve > total - head - tail ||
+        size > total - head - tail - head_reserve) return 0;
+    /* Preserve the existing maximum three-quarter tail ownership policy. */
+    if (tail > (total / 4) * 3 || size > (total / 4) * 3 - tail) return 0;
+    *offset = total - tail - size;
+    ios_jit_tail_reserved = tail + size;
+    return 1;
+}
