+
+bool readVersionTuple(const Module &module, StringRef name,
+                      unsigned expected_operands, unsigned value_offset,
+                      uint16_t &major, uint16_t &minor, std::string &error) {
+  auto *metadata = module.getNamedMetadata(name);
+  if (!metadata || metadata->getNumOperands() == 0) {
+    error = (Twine("missing AIR module metadata '") + name + "'").str();
+    return false;
+  }
+
+  bool found = false;
+  for (const MDNode *entry : metadata->operands()) {
+    if (!entry || entry->getNumOperands() != expected_operands) {
+      error = (Twine("invalid AIR module metadata '") + name + "': expected " +
+               Twine(expected_operands) + " operands per tuple")
+                  .str();
+      return false;
+    }
+    if (value_offset == 1) {
+      auto *language = dyn_cast<MDString>(entry->getOperand(0));
+      if (!language || language->getString() != "Metal") {
+        error = "invalid AIR language metadata: expected 'Metal'";
+        return false;
+      }
+    }
+    uint16_t current[2] = {};
+    for (unsigned i = 0; i < 3; ++i) {
+      auto *constant = dyn_cast<ConstantAsMetadata>(entry->getOperand(value_offset + i));
+      auto *integer = constant ? dyn_cast<ConstantInt>(constant->getValue()) : nullptr;
+      if (!integer || integer->getValue().getActiveBits() > 16) {
+        error = (Twine("invalid AIR module metadata '") + name +
+                 "': version components must be 16-bit integers")
+                    .str();
+        return false;
+      }
+      if (i == 2) {
+        if (integer->getZExtValue() != 0) {
+          error = (Twine("unsupported revision in AIR module metadata '") +
+                   name + "'").str();
+          return false;
+        }
+        continue;
+      }
+      current[i] = static_cast<uint16_t>(integer->getZExtValue());
+    }
+    if (!found) {
+      major = current[0];
+      minor = current[1];
+      found = true;
+    } else if (major != current[0] || minor != current[1]) {
+      error = (Twine("conflicting AIR module metadata '") + name + "'").str();
+      return false;
+    }
+  }
+  return found;
+}
+
+bool getMetallibVersions(const Module &module, MetallibVersions &versions,
+                         std::string &error) {
+  if (!readVersionTuple(module, "air.version", 3, 0,
+                        versions.air_major, versions.air_minor, error) ||
+      !readVersionTuple(module, "air.language_version", 4, 1,
+                        versions.language_major, versions.language_minor, error))
+    return false;
+  return true;
+}
+
+uint32_t readLE32(const char *bytes) {
+  return support::endian::read32le(reinterpret_cast<const uint8_t *>(bytes));
+}
+
+void appendLE32(SmallVectorImpl<char> &bytes, uint32_t value) {
+  for (unsigned shift = 0; shift < 32; shift += 8)
+    bytes.push_back(static_cast<char>((value >> shift) & 0xff));
+}
+
+bool wrapDarwinBitcode(ArrayRef<char> raw, SmallVectorImpl<char> &wrapped,
+                       std::string &error) {
+  constexpr uint32_t magic = 0x0b17c0de;
+  constexpr uint32_t header_size = 20;
+  constexpr size_t alignment = 16;
+  if (raw.size() >= 4 && readLE32(raw.data()) == magic) {
+    if (raw.size() < header_size || readLE32(raw.data() + 4) != 0 ||
+        readLE32(raw.data() + 8) != header_size ||
+        readLE32(raw.data() + 16) != UINT32_MAX) {
+      error = "invalid Darwin AIR bitcode wrapper header";
+      return false;
+    }
+    const uint32_t payload_size = readLE32(raw.data() + 12);
+    const size_t unpadded_size = header_size + static_cast<size_t>(payload_size);
+    const size_t expected_size = (unpadded_size + alignment - 1) & ~(alignment - 1);
+    if (expected_size != raw.size()) {
+      error = "Darwin AIR bitcode wrapper size does not match its payload";
+      return false;
+    }
+    for (size_t i = unpadded_size; i < expected_size; ++i) {
+      if (raw[i] != 0) {
+        error = "Darwin AIR bitcode wrapper has nonzero alignment padding";
+        return false;
+      }
+    }
+    wrapped.append(raw.begin(), raw.end());
+    return true;
+  }
+
+  if (raw.size() > UINT32_MAX) {
+    error = "AIR bitcode payload exceeds Darwin wrapper size limit";
+    return false;
+  }
+  appendLE32(wrapped, magic);
+  appendLE32(wrapped, 0);
+  appendLE32(wrapped, header_size);
+  appendLE32(wrapped, static_cast<uint32_t>(raw.size()));
+  appendLE32(wrapped, UINT32_MAX);
+  wrapped.append(raw.begin(), raw.end());
+  while (wrapped.size() % alignment)
+    wrapped.push_back(0);
+  return true;
+}
