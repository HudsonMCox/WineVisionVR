+/* byte size of a render command that stereo pairing can copy, 0 if the command blocks pairing */
+static size_t
+stereoPairCommandSize(uint16_t type) {
+  switch (type) {
+  case WMTRenderCommandSetPSO:
+    return sizeof(wmtcmd_render_setpso);
+  case WMTRenderCommandDraw:
+    return sizeof(wmtcmd_render_draw);
+  case WMTRenderCommandDrawIndexed:
+    return sizeof(wmtcmd_render_draw_indexed);
+  case WMTRenderCommandDrawIndirect:
+    return sizeof(wmtcmd_render_draw_indirect);
+  case WMTRenderCommandDrawIndexedIndirect:
+    return sizeof(wmtcmd_render_draw_indexed_indirect);
+  case WMTRenderCommandSetViewport:
+    return sizeof(wmtcmd_render_setviewport);
+  case WMTRenderCommandSetScissorRect:
+    return sizeof(wmtcmd_render_setscissorrect);
+  case WMTRenderCommandSetRasterizerState:
+    return sizeof(wmtcmd_render_setrasterizerstate);
+  case WMTRenderCommandSetDepthStencilState:
+    return sizeof(wmtcmd_render_setdepthstencilstate);
+  case WMTRenderCommandSetBlendFactorAndStencilRef:
+    return sizeof(wmtcmd_render_setblendcolor);
+  case WMTRenderCommandSetStencilRef:
+    return sizeof(wmtcmd_render_setstencilref);
+  case WMTRenderCommandSetVertexBufferOffset:
+  case WMTRenderCommandSetFragmentBufferOffset:
+    return sizeof(wmtcmd_render_setbufferoffset);
+  default:
+    return 0;
+  }
+}
+
+/**
+Rewrites r0 (the former pass) to render both eyes with vertex amplification and absorbs r1 (the latter pass).
+Only pairs passes that are provably the same work for both eyes, see the checks below. On failure nothing is changed.
+*/
+bool
+ArgumentEncodingContext::tryPairStereoPasses(RenderEncoderData *r0, RenderEncoderData *r1) {
+  // r1 must be the next live encoder after r0
+  EncoderData *next = r0->next;
+  while (next && next->type == EncoderType::Null)
+    next = next->next;
+  if (next != r1)
+    return false;
+
+  // the two eyes must be consecutive layers of the same eye target texture
+  const StereoEyeTargets &eye = r0->eye_targets;
+  if (!eye.valid || eye.left == nullptr || eye.right == nullptr || !(eye.left == eye.right) ||
+      eye.rightSlice != eye.leftSlice + 1)
+    return false;
+
+  if (r0->stereo_pass || r1->stereo_pass)
+    return false;
+  if (r0->render_target_array_length != 1 || r1->render_target_array_length != 1)
+    return false;
+  if (r0->render_target_count == 0 || r0->render_target_count != r1->render_target_count)
+    return false;
+  if (r0->default_raster_sample_count != r1->default_raster_sample_count)
+    return false;
+  if (r0->render_target_width != r1->render_target_width || r0->render_target_height != r1->render_target_height)
+    return false;
+  if (r0->dsv_planar_flags != r1->dsv_planar_flags || r0->dsv_readonly_flags != r1->dsv_readonly_flags)
+    return false;
+  if (r0->allocated_argbuf != r1->allocated_argbuf || !r0->allocated_argbuf_mapping || !r1->allocated_argbuf_mapping)
+    return false;
+  // a layered pass is never foveated, so both passes must agree on foveation eligibility
+  if (r0->foveation_safe != r1->foveation_safe)
+    return false;
+  if (r0->use_visibility_result || r1->use_visibility_result || r0->use_tessellation || r1->use_tessellation ||
+      r0->use_geometry || r1->use_geometry || r0->use_emulated_so || r1->use_emulated_so)
+    return false;
+  if (!r0->gs_arg_marshal_tasks.empty() || !r0->ts_arg_marshal_tasks.empty() || !r1->gs_arg_marshal_tasks.empty() ||
+      !r1->ts_arg_marshal_tasks.empty())
+    return false;
+  if (r1->fence_wait_vertex.intersectedWith(r0->fence_update) || hasDataDependency(r1, r0))
+    return false;
+
+  // colour attachments: same eye texture, slices eye0/eye1, identical load/clear, stored, no resolve
+  for (unsigned i = 0; i < r0->render_target_count; i++) {
+    auto &a0 = r0->colors[i];
+    auto &a1 = r1->colors[i];
+    if (!a0.attachment || !a1.attachment) {
+      if (a0.attachment || a1.attachment)
+        return false;
+      continue;
+    }
+    if (!(a0.attachment.texture() == eye.left) || !(a1.attachment.texture() == eye.left))
+      return false;
+    if (a0.level || a1.level || a0.depth_plane || a1.depth_plane)
+      return false;
+    if (a0.slice != eye.leftSlice || a1.slice != eye.rightSlice)
+      return false;
+    if (a0.resolve_attachment || a1.resolve_attachment)
+      return false;
+    if (a0.store_action != WMTStoreActionStore || a1.store_action != WMTStoreActionStore)
+      return false;
+    if (a0.load_action != a1.load_action)
+      return false;
+    if (a0.load_action == WMTLoadActionClear && std::memcmp(&a0.clear_color, &a1.clear_color, sizeof(a0.clear_color)))
+      return false;
+  }
+
+  // depth: either absent in both, or consecutive slices of one depth texture
+  if (static_cast<bool>(r0->depth.attachment) != static_cast<bool>(r1->depth.attachment))
+    return false;
+  if (r0->depth.attachment) {
+    if (!(r0->depth.attachment.texture() == r1->depth.attachment.texture()))
+      return false;
+    if (r0->depth.level || r1->depth.level || r0->depth.depth_plane || r1->depth.depth_plane)
+      return false;
+    if (r0->depth.slice + 1 != r1->depth.slice)
+      return false;
+    if (r0->depth.load_action != r1->depth.load_action || r0->depth.store_action != r1->depth.store_action)
+      return false;
+    if (r0->depth.load_action == WMTLoadActionClear && r0->depth.clear_depth != r1->depth.clear_depth)
+      return false;
+    if (!(r0->dsv_readonly_flags & 1) && r0->depth.store_action != WMTStoreActionStore)
+      return false;
+  }
+  if (r0->stencil.attachment || r1->stencil.attachment)
+    return false;
+
+  // Walk both command lists in lockstep and build the replacement list for r0 in a fresh chain.
+  auto *a = static_cast<wmtcmd_base *>(r0->cmd_head.next.get());
+  auto *b = static_cast<wmtcmd_base *>(r1->cmd_head.next.get());
+
+  wmtcmd_render_nop head{};
+  head.type = WMTRenderCommandNop;
+  wmtcmd_base *tail = (wmtcmd_base *)&head;
+  auto append = [&tail](wmtcmd_base *cmd) {
+    tail->next.set(cmd);
+    tail = cmd;
+  };
+  auto cloneCommand = [this](wmtcmd_base *src, size_t size) {
+    auto dst = (wmtcmd_base *)allocate_cpu_heap(size, 16);
+    std::memcpy((void *)dst, (void *)src, size);
+    dst->next.set(nullptr);
+    return dst;
+  };
+  auto appendEyeOffset = [&append, this](uint8_t index, uint64_t offset) {
+    auto cmd = (wmtcmd_render_setbufferoffset *)allocate_cpu_heap(sizeof(wmtcmd_render_setbufferoffset), 16);
+    std::memset((void *)cmd, 0, sizeof(*cmd));
+    cmd->type = WMTRenderCommandSetVertexBufferOffset;
+    cmd->offset = offset;
+    cmd->index = index;
+    append((wmtcmd_base *)cmd);
+  };
+
+  // eye1 argument table and constant buffer live in the pass argument buffer, bound at the EYE1 indices
+  {
+    auto bind = (wmtcmd_render_setbuffer *)allocate_cpu_heap(sizeof(wmtcmd_render_setbuffer), 16);
+    std::memset((void *)bind, 0, sizeof(*bind));
+    bind->type = WMTRenderCommandSetVertexBuffer;
+    bind->buffer = r0->allocated_argbuf;
+    bind->offset = 0;
+    bind->index = SM50_BINDING_INDEX_ARGUMENT_TABLE_EYE1;
+    append((wmtcmd_base *)bind);
+  }
+  {
+    auto bind = (wmtcmd_render_setbuffer *)allocate_cpu_heap(sizeof(wmtcmd_render_setbuffer), 16);
+    std::memset((void *)bind, 0, sizeof(*bind));
+    bind->type = WMTRenderCommandSetVertexBuffer;
+    bind->buffer = r0->allocated_argbuf;
+    bind->offset = 0;
+    bind->index = SM50_BINDING_INDEX_CONSTANT_BUFFER_EYE1;
+    append((wmtcmd_base *)bind);
+  }
+  {
+    auto amplify = (wmtcmd_render_setvertexamplification *)allocate_cpu_heap(
+        sizeof(wmtcmd_render_setvertexamplification), 16);
+    std::memset((void *)amplify, 0, sizeof(*amplify));
+    amplify->type = WMTRenderCommandSetVertexAmplification;
+    amplify->count = 2;
+    amplify->mappings[0] = {0, 0};
+    amplify->mappings[1] = {0, 1};
+    append((wmtcmd_base *)amplify);
+  }
+
+  bool sawPipeline = false, sawDraw = false;
+  bool eyeTableKnown = false, eyeConstantsKnown = false;
+  uint64_t eyeTableOffset = 0, eyeConstantsOffset = 0;
+  while (a && b) {
+    if (a->type != b->type)
+      return false;
+    const size_t size = stereoPairCommandSize(a->type);
+    if (!size)
+      return false;
+    wmtcmd_base *out = nullptr;
+    if (a->type == WMTRenderCommandSetPSO) {
+      auto pa = (wmtcmd_render_setpso *)a;
+      auto pb = (wmtcmd_render_setpso *)b;
+      if (pa->pso != pb->pso || !pa->stereo_pso)
+        return false;
+      auto stereo = (wmtcmd_render_setpso *)cloneCommand(a, size);
+      stereo->pso = stereo->stereo_pso;
+      out = (wmtcmd_base *)stereo;
+      sawPipeline = true;
+    } else if (a->type == WMTRenderCommandDraw || a->type == WMTRenderCommandDrawIndexed ||
+               a->type == WMTRenderCommandDrawIndirect || a->type == WMTRenderCommandDrawIndexedIndirect) {
+      if (!sawPipeline || !eyeTableKnown || !eyeConstantsKnown)
+        return false;
+      if (std::memcmp((char *)a + sizeof(wmtcmd_base), (char *)b + sizeof(wmtcmd_base),
+                      size - sizeof(wmtcmd_base)) != 0)
+        return false;
+      appendEyeOffset(SM50_BINDING_INDEX_ARGUMENT_TABLE_EYE1, eyeTableOffset);
+      appendEyeOffset(SM50_BINDING_INDEX_CONSTANT_BUFFER_EYE1, eyeConstantsOffset);
+      out = cloneCommand(a, size);
+      sawDraw = true;
+    } else if (a->type == WMTRenderCommandSetVertexBufferOffset ||
+               a->type == WMTRenderCommandSetFragmentBufferOffset) {
+      auto pa = (wmtcmd_render_setbufferoffset *)a;
+      auto pb = (wmtcmd_render_setbufferoffset *)b;
+      if (pa->index != pb->index)
+        return false;
+      const bool vertex = a->type == WMTRenderCommandSetVertexBufferOffset;
+      if (vertex && pa->index == SM50_BINDING_INDEX_ARGUMENT_TABLE) {
+        // may differ per eye: eye0 keeps its own, eye1 is bound at the EYE1 index before each draw
+        eyeTableKnown = true;
+        eyeTableOffset = pb->offset;
+      } else if (vertex && pa->index == SM50_BINDING_INDEX_CONSTANT_BUFFER) {
+        eyeConstantsKnown = true;
+        eyeConstantsOffset = pb->offset;
+      } else if ((vertex && pa->index == SM50_BINDING_INDEX_VERTEX_BUFFER) ||
+                 (!vertex && (pa->index == SM50_BINDING_INDEX_CONSTANT_BUFFER ||
+                              pa->index == SM50_BINDING_INDEX_ARGUMENT_TABLE))) {
+        // must be byte-identical: compare table contents over the bytes the emitter wrote
+        if (!pa->table_size_known || !pb->table_size_known || pa->table_size != pb->table_size)
+          return false;
+        if (pa->offset < r0->allocated_argbuf_offset || pb->offset < r1->allocated_argbuf_offset)
+          return false;
+        auto bytesA = (const char *)r0->allocated_argbuf_mapping + (pa->offset - r0->allocated_argbuf_offset);
+        auto bytesB = (const char *)r1->allocated_argbuf_mapping + (pb->offset - r1->allocated_argbuf_offset);
+        if (std::memcmp(bytesA, bytesB, pa->table_size) != 0)
+          return false;
+      } else {
+        return false;
+      }
+      out = cloneCommand(a, size);
+    } else {
+      if (std::memcmp((char *)a + sizeof(wmtcmd_base), (char *)b + sizeof(wmtcmd_base),
+                      size - sizeof(wmtcmd_base)) != 0)
+        return false;
+      out = cloneCommand(a, size);
+    }
+    append(out);
+    a = static_cast<wmtcmd_base *>(a->next.get());
+    b = static_cast<wmtcmd_base *>(b->next.get());
+  }
+  if (a || b || !sawDraw)
+    return false;
+
+  // commit: r0 now renders both eyes, r1 is absorbed (its attachment state equals r0's, verified above)
+  r0->cmd_head.next.set(head.next.get());
+  r0->cmd_tail = tail;
+  r0->render_target_array_length = 2;
+  r0->stereo_pass = true;
+  r0->foveation_draw_calls += r1->foveation_draw_calls;
+  r0->fence_update.merge(r1->fence_update);
+  r0->fence_wait.merge(r1->fence_wait);
+  r0->fence_update_vertex.merge(r1->fence_update_vertex);
+  r0->fence_wait_vertex.merge(r1->fence_wait_vertex);
+  currentFrameStatistics().stereo_pass_merged++;
+  r1->~RenderEncoderData();
+  r1->next = nullptr;
+  r1->type = EncoderType::Null;
+  return true;
+}
