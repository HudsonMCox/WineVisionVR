+  // Mirrors the D3D11 foveation rule: the pixel shader may only read SV_Position as a system value, neither
+  // stage may write UAVs, and hull, domain, geometry and stream output stages are never foveated.
+  bool
+  ComputeFoveationSafe(const D3D12_GRAPHICS_PIPELINE_STATE_DESC *pDesc) {
+    if (!pDesc->VS.pShaderBytecode || !pDesc->PS.pShaderBytecode)
+      return false;
+    if (pDesc->HS.pShaderBytecode || pDesc->DS.pShaderBytecode || pDesc->GS.pShaderBytecode ||
+        pDesc->StreamOutput.NumEntries)
+      return false;
+    if (ref_vs.UAVSlotMask || ref_ps.UAVSlotMask || ref_ps.PixelShader.HasCoverageOutput)
+      return false;
+    microsoft::CSignatureParser input;
+    if (FAILED(microsoft::DXBCGetInputSignature(pDesc->PS.pShaderBytecode, &input)))
+      return false;
+    const microsoft::D3D11_SIGNATURE_PARAMETER *parameters = nullptr;
+    const auto count = input.GetParameters(&parameters);
+    for (unsigned i = 0; i < count; ++i) {
+      // The companion AIR writer remaps SV_Position with the system map.
+      // Other built-ins remain uniform until their semantics are supported.
+      if (parameters[i].SystemValue != microsoft::D3D10_SB_NAME_UNDEFINED &&
+          parameters[i].SystemValue != microsoft::D3D10_SB_NAME_POSITION)
+        return false;
+    }
+    return true;
+  }
+
