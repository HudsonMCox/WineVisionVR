+            foveation.stencilClear = render_pass_info.stencil.clear_stencil;
+            foveation.depthStencilReadOnlyMask = data->dsv_readonly_flags;
+            foveation.drawCalls = data->foveation_draw_calls;
+            foveation.arrayLength = render_pass_info.render_target_array_length;
+            foveation.colorSlice = color.slice;
+            foveation.depthSlice = render_pass_info.depth.slice;
+            foveation.width = render_pass_info.render_target_width;
+            foveation.height = render_pass_info.render_target_height;
+            foveation.colorLoad = color.load_action;
+            foveation.depthLoad = render_pass_info.depth.load_action;
+            foveation.clearColor[0] = color.clear_color.r;
+            foveation.clearColor[1] = color.clear_color.g;
+            foveation.clearColor[2] = color.clear_color.b;
+            foveation.clearColor[3] = color.clear_color.a;
+            foveation.clearDepth = render_pass_info.depth.clear_depth;
+            WMTWindowsVRBridgeCallV1(reinterpret_cast<WMTWindowsVRRequestV1 *>(&foveation));
+          }
+          WMT::RenderCommandEncoder encoder{};
+          if (foveation.status == 0 && foveation.encoder)
