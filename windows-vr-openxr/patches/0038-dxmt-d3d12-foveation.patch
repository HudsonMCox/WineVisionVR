+            WMTWindowsVRBridgeCallV1(reinterpret_cast<WMTWindowsVRRequestV1 *>(&uniform));
+          }
           encoder.waitForFence(fence_, WMTRenderStageVertex);
+          if (foveation.status == 0 && foveation.encoder) {
