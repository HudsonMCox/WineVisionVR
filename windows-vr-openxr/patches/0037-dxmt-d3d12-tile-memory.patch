   void STDMETHODCALLTYPE DiscardResource(ID3D12Resource *pResource, const D3D12_DISCARD_REGION *pRegion) {
-    // do nothing for now
+    // only whole-resource discards are tracked, partial regions keep their contents
+    if (!pResource || pRegion)
+      return;
+    auto resource = static_cast<MTLD3D12Resource *>(pResource);
+    if (!resource->texture)
+      return;
+    auto texture = resource->texture.ptr();
+
+    // the open pass can no longer keep the contents of this texture, so close it storing nothing
+    if (allocator_->encoder_current && allocator_->encoder_current->type == EncoderType::Render) {
+      auto render = static_cast<RenderEncoderData *>(allocator_->encoder_current);
+      for (unsigned i = 0; i < num_rtvs; i++) {
+        if (!rtvs[i].ptr)
+          continue;
+        auto [Heap, Index] = GetRenderTargetHeap(device_, rtvs[i]);
+        if (Heap->GetRenderTarget(Index).Texture == texture)
+          render->colors[i].store_action = WMTStoreActionDontCare;
+      }
+      if (dsv.ptr) {
+        auto [Heap, Index] = GetRenderTargetHeap(device_, dsv);
+        if (Heap->GetRenderTarget(Index).Texture == texture) {
+          render->depth.store_action = WMTStoreActionDontCare;
+          render->stencil.store_action = WMTStoreActionDontCare;
+        }
+      }
+      allocator_->InvalidateCurrentPass();
+    }
+
+    pending_discards_.push_back({resource->texture, allocator_->encoder_last});
   };
 
