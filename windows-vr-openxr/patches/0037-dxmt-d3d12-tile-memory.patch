+  bool
+  IsPendingDiscard(Texture *texture) {
+    for (auto &discard : pending_discards_) {
+      if (discard.texture.ptr() == texture && discard.after == allocator_->encoder_last)
+        return true;
+    }
+    return false;
+  }
+
+  // folds a full-extent clear that immediately precedes this pass into the pass load actions
+  void
+  FoldPrecedingClear(RenderEncoderData *render) {
+    auto encoder = allocator_->encoder_last;
+    if (!encoder || encoder->type != EncoderType::Clear)
+      return;
+    auto clear = static_cast<ClearEncoderData *>(encoder);
+    if (clear->clear_dsv) {
+      unsigned folded = 0;
+      if ((clear->clear_dsv & 1) && render->depth.attachment && render->depth.attachment.ptr() == clear->attachment.ptr())
+        folded |= 1;
+      if ((clear->clear_dsv & 2) && render->stencil.attachment && render->stencil.attachment.ptr() == clear->attachment.ptr())
+        folded |= 2;
+      if (folded != clear->clear_dsv)
+        return;
+      if (folded & 1) {
+        render->depth.load_action = WMTLoadActionClear;
+        render->depth.clear_depth = clear->depth_stencil.first;
+      }
+      if (folded & 2) {
+        render->stencil.load_action = WMTLoadActionClear;
+        render->stencil.clear_stencil = clear->depth_stencil.second;
+      }
+    } else {
+      auto same_color = [clear](const RenderEncoderColorAttachmentData &color) {
+        return color.attachment && color.attachment.ptr() == clear->attachment.ptr() &&
+               color.depth_plane == clear->depth_plane;
+      };
+      bool matched = false;
+      for (auto &color : render->colors)
+        matched |= same_color(color);
+      if (!matched)
+        return;
+      for (auto &color : render->colors) {
+        if (!same_color(color))
+          continue;
+        color.load_action = WMTLoadActionClear;
+        color.clear_color = clear->color;
+      }
+    }
+    // the pass now owns the clear, so drop the clear's view reference and neutralize its encoder
+    // (allocator Reset skips Null encoders and does not run their destructors)
+    clear->attachment = nullptr;
+    clear->type = EncoderType::Null;
+  }
