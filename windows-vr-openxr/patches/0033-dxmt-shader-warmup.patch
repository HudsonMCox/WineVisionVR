+        }
+        std::lock_guard<dxmt::mutex> lock(mutex_ia_);
+        MTL_INPUT_LAYOUT_DESC key = elements;
+        if (!input_layouts.contains(key)) {
+          uint32_t mask = 0;
+          for (const auto &e : elements)
+            mask |= (1u << e.Slot);
+          input_layouts.emplace(key, std::make_unique<CachedInputLayout>(std::move(elements), mask));
+        }
+        layout = input_layouts.at(key).get();
+      }
+
+      std::vector<unsigned long long> bs;
+      if (!ParseNumbers(field("bs", ""), &bs) || bs.size() != 82) {
+        WARN("Shader warm-up: skipped record with an invalid blend state");
+        continue;
+      }
+      D3D11_BLEND_DESC1 blend_desc = {};
+      blend_desc.AlphaToCoverageEnable = static_cast<BOOL>(bs[0]);
+      blend_desc.IndependentBlendEnable = static_cast<BOOL>(bs[1]);
+      for (unsigned i = 0; i < 8; ++i) {
+        const unsigned long long *v = &bs[2 + i * 10];
+        auto &rt = blend_desc.RenderTarget[i];
+        rt.BlendEnable = static_cast<BOOL>(v[0]);
+        rt.LogicOpEnable = static_cast<BOOL>(v[1]);
+        rt.SrcBlend = static_cast<D3D11_BLEND>(v[2]);
+        rt.DestBlend = static_cast<D3D11_BLEND>(v[3]);
+        rt.BlendOp = static_cast<D3D11_BLEND_OP>(v[4]);
+        rt.SrcBlendAlpha = static_cast<D3D11_BLEND>(v[5]);
+        rt.DestBlendAlpha = static_cast<D3D11_BLEND>(v[6]);
+        rt.BlendOpAlpha = static_cast<D3D11_BLEND_OP>(v[7]);
+        rt.LogicOp = static_cast<D3D11_LOGIC_OP>(v[8]);
+        rt.RenderTargetWriteMask = static_cast<UINT8>(v[9]);
+      }
+      IMTLD3D11BlendState *blend = nullptr;
+      if (FAILED(blend_states.CreateStateObject(&blend_desc, &blend)) || !blend) {
+        WARN("Shader warm-up: skipped record whose blend state failed to create");
+        continue;
+      }
+      warm_blend_refs_.push_back(blend); // QueryInterface reference, released in the destructor
+
+      std::vector<unsigned long long> fmt;
+      const unsigned long long nrt = number("nrt");
+      if (!ParseNumbers(field("fmt", ""), &fmt) || nrt > 8 || fmt.size() != nrt) {
+        WARN("Shader warm-up: skipped record with inconsistent render targets");
+        continue;
+      }
+
+      MTL_GRAPHICS_PIPELINE_DESC desc = {};
+      desc.VertexShader = vs;
+      desc.PixelShader = ps;
+      desc.InputLayout = layout;
+      desc.BlendState = blend;
+      desc.NumColorAttachments = static_cast<UINT>(nrt);
+      for (unsigned i = 0; i < nrt; ++i)
+        desc.ColorAttachmentFormats[i] = static_cast<WMTPixelFormat>(fmt[i]);
+      desc.DepthStencilFormat = static_cast<WMTPixelFormat>(number("dsf"));
+      desc.TopologyClass = static_cast<WMTPrimitiveTopologyClass>(number("topo"));
+      desc.RasterizationEnabled = number("rast") != 0;
+      desc.SampleCount = static_cast<uint8_t>(number("samples"));
+      desc.IndexBufferFormat = static_cast<SM50_INDEX_BUFFER_FORMAT>(number("ib"));
+      desc.GSStripTopology = number("gss") != 0;
+      desc.SampleMask = static_cast<uint32_t>(number("smask"));
+      desc.GSPassthrough = static_cast<uint32_t>(number("gspt"));
+      desc.StereoAmplified = number("sa") != 0;
+
+      std::lock_guard<dxmt::mutex> lock(mutex_);
+      if (!pipelines_.contains(desc)) {
+        auto result = pipelines_.insert({desc, CreateGraphicsPipeline(device, &desc)});
+        scheduler_.submit_low(result.first->second.get());
+        pending.push_back(result.first->second.get());
+      }
+    }
+
+    const size_t total = pending.size();
+    auto count_done = [&]() {
+      size_t done = 0;
+      for (auto *work : pending)
+        if (work->GetIsDone())
+          ++done;
+      return done;
+    };
+    auto last_write = std::chrono::steady_clock::now() - std::chrono::milliseconds(100);
+    size_t last_done = static_cast<size_t>(-1);
+    while (!warmup_cancel_.load()) {
+      const size_t done = count_done();
+      const auto now = std::chrono::steady_clock::now();
+      if (done != last_done && now - last_write >= std::chrono::milliseconds(100)) {
+        store.WriteProgress(done, total, false);
+        last_done = done;
+        last_write = now;
+      }
+      if (done == total)
+        break;
+      Sleep(20);
+    }
+    if (!warmup_cancel_.load())
+      store.WriteProgress(total, total, true);
+  }
+
 public:
   PipelineCache(MTLD3D11Device *pDevice) :
       scache_(ShaderCache::getInstance(pDevice->GetDXMTDevice().metalVersion())),
       device(pDevice),
       blend_states(pDevice),
-      so_layouts(pDevice) {};
+      so_layouts(pDevice) {
+    if (WarmupStore::Instance().ReplayEnabled() && WarmupStore::Instance().Enabled())
+      warmup_thread_ = dxmt::thread([this]() { RunWarmup(); });
+  };
+
+  ~PipelineCache() {
+    warmup_cancel_.store(true);
+    if (warmup_thread_.joinable())
+      warmup_thread_.join();
+    for (auto *blend : warm_blend_refs_)
+      blend->Release();
+  }
 };
 
