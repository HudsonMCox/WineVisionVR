+namespace {
+
+// Set only on the warm-up thread: shader variants and pipelines it creates queue at low priority.
+thread_local bool tl_warmup_worker = false;
+
+template <typename T> std::string Num(T value) {
+  return std::to_string(static_cast<unsigned long long>(value));
+}
+
+using WarmupBlobs = std::vector<std::pair<std::string, const std::vector<uint8_t> *>>;
+
+// Per-executable store under the existing cache root "dxmt\<exe>" (cwd-relative, next to shaders_N.db),
+// or %LOCALAPPDATA%\dxmt\<exe> when that cache is disabled or uses a unix path.
+//   pipelines.txt        one line per pipeline variant: key fields, shader hashes, blend state
+//   shaders\<sha1>.dxbc  DXBC blob of each shader referenced by a line, stored once
+//   warmup-progress      "done total" or "done total complete" (replaced atomically)
+class WarmupStore {
+public:
+  static WarmupStore &Instance() {
+    static WarmupStore store;
+    return store;
+  }
+
+  bool Enabled() const { return enabled_; }
+  bool ReplayEnabled() const { return replay_; }
+
+  // Returns false when no store exists yet.
+  bool LoadRecords(std::vector<std::string> *lines) {
+    std::string text;
+    if (!enabled_ || !ReadWholeFile(RecordsPath(), &text))
+      return false;
+    std::lock_guard<dxmt::mutex> lock(mutex_);
+    size_t start = 0;
+    while (start < text.size()) {
+      size_t end = text.find('\n', start);
+      if (end == std::string::npos)
+        end = text.size();
+      std::string line = text.substr(start, end - start);
+      if (!line.empty() && line.back() == '\r')
+        line.pop_back();
+      if (!line.empty()) {
+        lines->push_back(line);
+        recorded_.insert(line);
+      }
+      start = end + 1;
+    }
+    return true;
+  }
+
+  bool ReadBlob(const std::string &hash, std::vector<uint8_t> *bytes) {
+    std::string data;
+    if (!enabled_ || !ReadWholeFile(ShaderPath(hash), &data))
+      return false;
+    bytes->assign(data.begin(), data.end());
+    return true;
+  }
+
+  // Append-only; called on the compile worker. Each line and each blob is written at most once per store.
+  void Record(const std::string &line, const WarmupBlobs &blobs) {
+    if (!enabled_)
+      return;
+    std::lock_guard<dxmt::mutex> lock(mutex_);
+    if (recorded_.count(line))
+      return;
+    for (const auto &[hash, bytes] : blobs) {
+      if (stored_.count(hash))
+        continue;
+      const std::string path = ShaderPath(hash);
+      if (!FileExists(path) && !WriteWholeFile(path, std::string(bytes->begin(), bytes->end()), false)) {
+        ERR("Shader warm-up: could not write ", path);
+        return;
+      }
+      stored_.insert(hash);
+    }
+    if (!WriteWholeFile(RecordsPath(), line + "\n", true)) {
+      ERR("Shader warm-up: could not append to ", RecordsPath());
+      return;
+    }
+    recorded_.insert(line);
+  }
+
+  // Called only from the warm-up thread.
+  void WriteProgress(size_t done, size_t total, bool complete) {
+    const std::string text = std::to_string(done) + " " + std::to_string(total) + (complete ? " complete\n" : "\n");
+    const std::string temp = root_ + "\\warmup-progress.tmp";
+    if (!WriteWholeFile(temp, text, false))
+      return;
+    const std::wstring wtemp = str::tows(temp.c_str());
+    const std::wstring wfinal = str::tows((root_ + "\\warmup-progress").c_str());
+    MoveFileExW(wtemp.c_str(), wfinal.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH);
+  }
+
+private:
+  WarmupStore() {
+    const std::string exe = env::getExeName();
+    if (env::getEnvVar("DXMT_SHADER_CACHE") != "0" && !env::getEnvVar("DXMT_SHADER_CACHE_PATH").starts_with("/")) {
+      root_ = "dxmt\\" + exe;
+    } else {
+      const std::string local = env::getEnvVar("LOCALAPPDATA");
+      if (!local.empty())
+        root_ = local + "\\dxmt\\" + exe;
+    }
+    if (root_.empty())
+      return;
+    env::createDirectory(root_.substr(0, root_.rfind('\\')));
+    env::createDirectory(root_);
+    env::createDirectory(root_ + "\\shaders");
+    replay_ = env::getEnvVar("DXMT_SHADER_WARMUP") != "0";
+    enabled_ = true;
+  }
+
+  std::string RecordsPath() const { return root_ + "\\pipelines.txt"; }
+  std::string ShaderPath(const std::string &hash) const { return root_ + "\\shaders\\" + hash + ".dxbc"; }
+
+  static bool FileExists(const std::string &path) {
+    return GetFileAttributesW(str::tows(path.c_str()).c_str()) != INVALID_FILE_ATTRIBUTES;
+  }
+
+  static bool ReadWholeFile(const std::string &path, std::string *out) {
+    FILE *file = _wfopen(str::tows(path.c_str()).c_str(), L"rb");
+    if (!file)
+      return false;
+    out->clear();
+    char buffer[65536];
+    size_t count;
+    while ((count = fread(buffer, 1, sizeof(buffer), file)) > 0)
+      out->append(buffer, count);
+    fclose(file);
+    return true;
+  }
+
+  static bool WriteWholeFile(const std::string &path, const std::string &data, bool append) {
+    FILE *file = _wfopen(str::tows(path.c_str()).c_str(), append ? L"ab" : L"wb");
+    if (!file)
+      return false;
+    const size_t written = fwrite(data.data(), 1, data.size(), file);
+    const int closed = fclose(file);
+    return written == data.size() && closed == 0;
+  }
+
+  std::string root_;
+  bool enabled_ = false;
+  bool replay_ = false;
+  dxmt::mutex mutex_;
+  std::unordered_set<std::string> recorded_;
+  std::unordered_set<std::string> stored_;
+};
+
+// Parses "key=value" tokens; the first token is the record kind.
+std::unordered_map<std::string, std::string> ParseFields(const std::string &line) {
+  std::unordered_map<std::string, std::string> fields;
+  size_t start = 0;
+  while (start <= line.size()) {
+    size_t end = line.find(' ', start);
+    if (end == std::string::npos)
+      end = line.size();
+    const std::string token = line.substr(start, end - start);
+    const size_t eq = token.find('=');
+    if (eq != std::string::npos)
+      fields[token.substr(0, eq)] = token.substr(eq + 1);
+    start = end + 1;
+  }
+  return fields;
+}
+
+std::vector<std::string> SplitBy(const std::string &text, char separator) {
+  std::vector<std::string> parts;
+  if (text.empty())
+    return parts;
+  size_t start = 0;
+  while (true) {
+    size_t end = text.find(separator, start);
+    parts.push_back(text.substr(start, end == std::string::npos ? std::string::npos : end - start));
+    if (end == std::string::npos)
+      break;
+    start = end + 1;
+  }
+  return parts;
+}
+
+bool ParseNumbers(const std::string &csv, std::vector<unsigned long long> *out) {
+  out->clear();
+  if (csv.empty())
+    return true;
+  for (const auto &part : SplitBy(csv, ',')) {
+    if (part.empty() || part.find_first_not_of("0123456789") != std::string::npos)
+      return false;
+    out->push_back(std::strtoull(part.c_str(), nullptr, 10));
+  }
+  return true;
+}
+
+// Serializes a graphics PSO key. Returns false for pipelines the warm-up cannot replay.
+bool SerializeGraphics(const MTL_GRAPHICS_PIPELINE_DESC &desc, std::string *line, WarmupBlobs *blobs) {
+  if (!desc.VertexShader || !desc.BlendState || desc.HullShader || desc.DomainShader || desc.GeometryShader ||
+      desc.SOLayout || desc.NumColorAttachments > 8)
+    return false;
+  std::string s = "g";
+  blobs->emplace_back(desc.VertexShader->sha1().string(), &desc.VertexShader->bytecode_blob());
+  s += " vs=" + desc.VertexShader->sha1().string();
+  s += " ps=";
+  if (desc.PixelShader) {
+    blobs->emplace_back(desc.PixelShader->sha1().string(), &desc.PixelShader->bytecode_blob());
+    s += desc.PixelShader->sha1().string();
+  } else {
+    s += "-";
+  }
+  s += " il=";
+  if (!desc.InputLayout) {
+    s += "-";
+  } else {
+    MTL_SHADER_INPUT_LAYOUT_ELEMENT_DESC *elements = nullptr;
+    const uint32_t count = desc.InputLayout->input_layout_element(&elements);
+    for (uint32_t i = 0; i < count; ++i) {
+      if (i)
+        s += ";";
+      const auto &e = elements[i];
+      s += Num(e.Index) + "," + Num(e.Slot) + "," + Num(e.Offset) + "," + Num(e.Format) + "," +
+           Num(e.StepFunction) + "," + Num(e.InstanceStepRate);
+    }
+  }
+  D3D11_BLEND_DESC1 bd = {};
+  desc.BlendState->GetDesc1(&bd);
+  s += " bs=" + Num(bd.AlphaToCoverageEnable) + "," + Num(bd.IndependentBlendEnable);
+  for (const auto &rt : bd.RenderTarget) {
+    s += "," + Num(rt.BlendEnable) + "," + Num(rt.LogicOpEnable) + "," + Num(rt.SrcBlend) + "," + Num(rt.DestBlend) +
+         "," + Num(rt.BlendOp) + "," + Num(rt.SrcBlendAlpha) + "," + Num(rt.DestBlendAlpha) + "," +
+         Num(rt.BlendOpAlpha) + "," + Num(rt.LogicOp) + "," + Num(rt.RenderTargetWriteMask);
+  }
+  s += " nrt=" + Num(desc.NumColorAttachments);
+  s += " fmt=";
+  for (unsigned i = 0; i < desc.NumColorAttachments; ++i) {
+    if (i)
+      s += ",";
+    s += Num(desc.ColorAttachmentFormats[i]);
+  }
+  s += " dsf=" + Num(desc.DepthStencilFormat);
+  s += " topo=" + Num(desc.TopologyClass);
+  s += " rast=" + Num(desc.RasterizationEnabled);
+  s += " samples=" + Num(desc.SampleCount);
+  s += " ib=" + Num(desc.IndexBufferFormat);
+  s += " gss=" + Num(desc.GSStripTopology);
+  s += " smask=" + Num(desc.SampleMask);
+  s += " gspt=" + Num(desc.GSPassthrough);
+  s += " sa=" + Num(desc.StereoAmplified);
+  s += " fov=" + Num(desc.PixelShader ? desc.PixelShader->allowsFoveatedRaster() : false);
+  *line = s;
+  return true;
+}
+
+} // namespace
+
+void WarmupRecordGraphicsPipeline(const MTL_GRAPHICS_PIPELINE_DESC &desc) {
+  WarmupStore &store = WarmupStore::Instance();
+  if (!store.Enabled())
+    return;
+  std::string line;
+  WarmupBlobs blobs;
+  if (SerializeGraphics(desc, &line, &blobs))
+    store.Record(line, blobs);
+}
+
+void WarmupRecordComputePipeline(ManagedShader shader) {
+  WarmupStore &store = WarmupStore::Instance();
+  if (!store.Enabled() || !shader)
+    return;
+  WarmupBlobs blobs;
+  blobs.emplace_back(shader->sha1().string(), &shader->bytecode_blob());
+  store.Record("c cs=" + shader->sha1().string(), blobs);
+}
