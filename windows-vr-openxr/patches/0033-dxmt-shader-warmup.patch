+  // Runs on the warm-up thread: recreates recorded shaders and PSOs at low priority and reports progress.
+  void RunWarmup() {
+    tl_warmup_worker = true;
+    WarmupStore &store = WarmupStore::Instance();
+    std::vector<std::string> lines;
+    if (!store.LoadRecords(&lines) || lines.empty())
+      return;
+
+    std::unordered_map<std::string, CachedSM50Shader *> warm_shaders;
+    auto warm_shader = [&](const std::string &hash) -> CachedSM50Shader * {
+      auto found = warm_shaders.find(hash);
+      if (found != warm_shaders.end())
+        return found->second;
+      CachedSM50Shader *shader = nullptr;
+      std::vector<uint8_t> bytes;
+      if (store.ReadBlob(hash, &bytes) && !bytes.empty()) {
+        shader = CreateShader(bytes.data(), static_cast<uint32_t>(bytes.size()));
+        if (shader && shader->sha1().string() != hash)
+          shader = nullptr;
+      }
+      warm_shaders.emplace(hash, shader);
+      return shader;
+    };
+
+    std::vector<ThreadpoolWork *> pending;
+    for (const auto &line : lines) {
+      if (warmup_cancel_.load())
+        return;
+      const auto fields = ParseFields(line);
+      auto field = [&](const char *key, const char *fallback) -> std::string {
+        auto value = fields.find(key);
+        return value == fields.end() ? std::string(fallback) : value->second;
+      };
+      auto number = [&](const char *key) -> unsigned long long {
+        return std::strtoull(field(key, "0").c_str(), nullptr, 10);
+      };
+
+      if (line.compare(0, 2, "c ") == 0) {
+        CachedSM50Shader *shader = warm_shader(field("cs", ""));
+        if (!shader) {
+          WARN("Shader warm-up: skipped compute record with a missing shader");
+          continue;
+        }
+        ManagedShader key = shader;
+        std::lock_guard<dxmt::mutex> lock(mutex_cs_);
+        if (!pipelines_cs_.contains(key)) {
+          auto result = pipelines_cs_.insert({key, CreateComputePipeline(device, key)});
+          scheduler_.submit_low(result.first->second.get());
+          pending.push_back(result.first->second.get());
+        }
+        continue;
+      }
+      if (line.compare(0, 2, "g ") != 0)
+        continue;
+
+      const std::string ps_hash = field("ps", "-");
+      CachedSM50Shader *vs = warm_shader(field("vs", ""));
+      CachedSM50Shader *ps = ps_hash == "-" ? nullptr : warm_shader(ps_hash);
