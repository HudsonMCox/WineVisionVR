+template <typename Task>
+void
+task_scheduler<Task>::submit_low(Task task) {
+  std::unique_lock<dxmt::mutex> lock(worker_mutex_);
+  task_low_queue_.push_back(task);
+  worker_cond_.notify_one();
+}
+
+// Moves a queued low-priority task to the normal queue; no-op if it already runs or finished.
+template <typename Task>
+void
+task_scheduler<Task>::promote(Task task) {
+  std::unique_lock<dxmt::mutex> lock(worker_mutex_);
+  for (auto it = task_low_queue_.begin(); it != task_low_queue_.end(); ++it) {
+    if (*it == task) {
+      task_low_queue_.erase(it);
+      task_queue_.push(task);
+      worker_cond_.notify_one();
+      break;
+    }
+  }
