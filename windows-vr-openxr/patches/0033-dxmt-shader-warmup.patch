+          e.Slot = static_cast<uint32_t>(n[1]);
+          e.Offset = static_cast<uint32_t>(n[2]);
+          e.Format = static_cast<uint32_t>(n[3]);
+          e.StepFunction = static_cast<D3D11_INPUT_CLASSIFICATION>(n[4]);
+          e.InstanceStepRate = static_cast<uint32_t>(n[5]);
