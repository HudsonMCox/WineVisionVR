diff --git a/src/d3d11/d3d11_context_imm.cpp b/src/d3d11/d3d11_context_imm.cpp
index 1fcb486..749969e 100644
--- a/src/d3d11/d3d11_context_imm.cpp
+++ b/src/d3d11/d3d11_context_imm.cpp
@@ -508,8 +508,17 @@ public:
     }
     if (hr == S_FALSE && (GetDataFlags & D3D11_ASYNC_GETDATA_DONOTFLUSH) == 0) {
       cmd_queue.CurrentFrameStatistics().event_stall++;
-      if (!eventQuery || eventQuery->RequestFlush())
-        Flush();
+      if (!eventQuery || eventQuery->RequestFlush()) {
+        // Flush1 only submits work recorded since the last commit or a pending
+        // query end (both tracked by these flags). Checking them here avoids
+        // re-entering the flush path on every poll of an idle context. Chunk
+        // ids alone are not used: End() on an occlusion or timestamp query
+        // records without advancing the chunk, so a chunk-id check could skip
+        // the flush that submits that query's end and spin forever.
+        std::lock_guard<d3d11_device_mutex> lock(mutex);
+        if (ctx_state.has_dirty_op_since_last_event || promote_flush)
+          Flush();
+      }
     }
     return hr;
   }
