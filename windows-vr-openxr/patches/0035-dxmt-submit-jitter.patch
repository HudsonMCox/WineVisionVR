+
+WINEMETAL_API int32_t
+WMTWindowsVRBridgeCallV3(WMTWindowsVRRequestV3 *request) {
+  if (!request)
+    return WVRCompositorStatusInvalidArgument;
+  struct unixcall_windows_vr_bridge_v1 params;
+  memset(&params, 0, sizeof(params));
+  WMT_MEMPTR_SET(params.request, request);
+  UNIX_CALL(148, &params);
+  return request->status;
+}
