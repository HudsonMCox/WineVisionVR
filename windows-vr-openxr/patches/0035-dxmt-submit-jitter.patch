diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
index d8b9f95..b424493 100644
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -3353,6 +3353,56 @@ _WMTWindowsVRBridgeCallV1(void *obj) {
   return STATUS_SUCCESS;
 }
 
+static NTSTATUS
+_WMTWindowsVRBridgeCallV3(void *obj) {
+  struct unixcall_windows_vr_bridge_v1 *params = obj;
+  WMTWindowsVRRequestV3 *request = params->request.ptr;
+  if (!request || request->abiVersion != WMT_WINDOWSVR_REQUEST_ABI_V3 ||
+      request->structSize != sizeof(*request))
+    return STATUS_INVALID_ADDRESS;
+  request->status = WVRCompositorStatusInvalidArgument;
+  id<MTLCommandBuffer> command_buffer = (id<MTLCommandBuffer>)(uintptr_t)request->commandBuffer;
+  id<MTLTexture> left = (id<MTLTexture>)(uintptr_t)request->leftTexture;
+  id<MTLTexture> right = (id<MTLTexture>)(uintptr_t)request->rightTexture;
+  id<MTLSharedEvent> producer_event = (id<MTLSharedEvent>)(uintptr_t)request->producerEvent;
+  id<MTLSharedEvent> consumer_event = (id<MTLSharedEvent>)wvr_compositor_copy_consumer_event_v1();
+  if (!command_buffer || !left || !right || !producer_event || !consumer_event) {
+    if (consumer_event)
+      wvr_compositor_release_object_v1(consumer_event);
+    return STATUS_SUCCESS;
+  }
+  WVRSubmitStereoFrameV3 frame = {};
+  frame.abiVersion = WVR_COMPOSITOR_ABI_VERSION_V3;
+  frame.structSize = sizeof(frame);
+  frame.producerFrameID = request->frameID;
+  frame.producerTimestampNanoseconds = request->timestampNanoseconds;
+  frame.leftTexture = left;
+  frame.rightTexture = right;
+  frame.producerReadyEvent = producer_event;
+  frame.producerReadyValue = request->producerValue;
+  frame.targetGeneration = request->targetGeneration;
+  frame.leftSlice = request->leftSlice;
+  frame.leftX = request->leftX;
+  frame.leftY = request->leftY;
+  frame.leftWidth = request->leftWidth;
+  frame.leftHeight = request->leftHeight;
+  frame.rightSlice = request->rightSlice;
+  frame.rightX = request->rightX;
+  frame.rightY = request->rightY;
+  frame.rightWidth = request->rightWidth;
+  frame.rightHeight = request->rightHeight;
+  frame.jitterFlags = request->jitterFlags;
+  frame.renderFlags = request->renderFlags;
+  frame.jitterPixelX = request->jitterPixelX;
+  frame.jitterPixelY = request->jitterPixelY;
+  request->status = wvr_compositor_submit_stereo_frame_v3(&frame, &request->compositorTicket);
+  if (request->status == WVRCompositorStatusOK)
+    request->consumerEvent = (uint64_t)(uintptr_t)consumer_event;
+  else
+    wvr_compositor_release_object_v1(consumer_event);
+  return STATUS_SUCCESS;
+}
