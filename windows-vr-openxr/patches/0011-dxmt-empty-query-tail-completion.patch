+// Preserve an ended query's final completion barrier even when that chunk
+// contains no visibility samples. Readback destruction runs on the ordered
+// finish thread after GPU completion, so earlier real samples are retained.
+inline std::unique_ptr<VisibilityResultReadback>
+FlushVisibilityQueries(WMT::Device device, uint64_t seqId, uint64_t count,
+                       std::vector<Rc<VisibilityResultQuery>> &queries) {
+  std::unique_ptr<VisibilityResultReadback> readback;
+  if (count || !queries.empty())
+    readback = std::make_unique<VisibilityResultReadback>(device, seqId, count, queries);
+  std::erase_if(queries, [=](const auto &query) { return query->queryEndAt() == seqId; });
+  return readback;
+}
