+        }
+        if (!covers)
+          return;
+      }
+      InvalidateCurrentPass();
+      EmitOP([texture = view->texture(), viewId = view->viewId()](ArgumentEncodingContext &enc) mutable {
+        enc.discardAttachment(forward_rc(texture), viewId);
+      });
+    };
+
+    if (auto rtv = com_cast<ID3D11RenderTargetView>(pResourceView)) {
+      discard(static_cast<D3D11RenderTargetView *>(rtv.ptr()));
+    } else if (auto dsv = com_cast<ID3D11DepthStencilView>(pResourceView)) {
+      discard(static_cast<D3D11DepthStencilView *>(dsv.ptr()));
