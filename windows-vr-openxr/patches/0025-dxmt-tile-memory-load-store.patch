+// true if `next` overwrites the whole attachment before anything can read it
+static bool
+isNextPassOverwriting(const RenderEncoderColorAttachmentData &color, EncoderData *next) {
+  if (!next || !color.attachment.ptr() || color.depth_plane != 0)
+    return false;
+  if (next->type == EncoderType::Clear) {
+    auto clear = static_cast<ClearEncoderData *>(next);
+    return clear->clear_dsv == 0 && clear->attachment.ptr() == color.attachment.ptr();
+  }
+  if (next->type == EncoderType::Render) {
+    auto render = static_cast<RenderEncoderData *>(next);
+    for (unsigned i = 0; i < render->render_target_count; i++) {
+      auto &attachment = render->colors[i];
+      if (attachment.attachment.ptr() != color.attachment.ptr())
+        continue;
+      return attachment.depth_plane == 0 &&
+             (attachment.load_action == WMTLoadActionClear || attachment.load_action == WMTLoadActionDontCare);
+    }
+  }
+  return false;
+}
