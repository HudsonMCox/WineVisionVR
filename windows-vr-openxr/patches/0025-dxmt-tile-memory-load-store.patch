+void
+ArgumentEncodingContext::discardAttachment(Rc<Texture> &&texture, uint64_t viewId) {
+  // contents are undefined from here on, so the pass that produced them does not need to store them
+  if (encoder_current)
+    endPass();
+  auto matches = [&](const TextureViewRef &attachment) {
+    return attachment.ptr() && attachment->allocation->descriptor == texture.ptr() &&
+           static_cast<uint64_t>(attachment->key) == viewId;
+  };
+  if (encoder_last->type == EncoderType::Render) {
+    auto render = static_cast<RenderEncoderData *>(encoder_last);
+    for (unsigned i = 0; i < render->render_target_count; i++) {
+      auto &color = render->colors[i];
+      if (matches(color.attachment) && color.store_action == WMTStoreActionStore)
+        color.store_action = WMTStoreActionDontCare;
+    }
+    if (matches(render->depth.attachment) && render->depth.store_action == WMTStoreActionStore)
+      render->depth.store_action = WMTStoreActionDontCare;
+    if (matches(render->stencil.attachment) && render->stencil.store_action == WMTStoreActionStore)
+      render->stencil.store_action = WMTStoreActionDontCare;
+  }
+  // the next render pass on this view starts with DontCare, see endPass()
+  discarded_texture_ = texture;
+  discarded_view_ = viewId;
+}
