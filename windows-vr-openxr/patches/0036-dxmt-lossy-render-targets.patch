@@ -315,9 +315,22 @@ extract_texture_descriptor(id<MTLTexture> desc, struct WMTTextureInfo *info) {
   info->sample_count = desc.sampleCount;
   info->usage = desc.usage;
   info->options = (enum WMTResourceOptions)desc.resourceOptions;
-  info->reserved = 0;
+  info->compression = 0;
 };
 
+// Lossy compression needs Apple8 and private storage; a request that does not qualify is ignored
+static void
+apply_lossy_compression(id<MTLDevice> device, MTLTextureDescriptor *desc, struct WMTTextureInfo *info) {
+  if (@available(macOS 12.5, iOS 15, visionOS 1.0, *)) {
+    if (info->usage & (WMTTextureUsageShaderWrite | WMTTextureUsagePixelFormatView))
+      return;
+    if (![device supportsFamily:(MTLGPUFamily)WMTGPUFamilyApple8])
+      return;
+    desc.compressionType = MTLTextureCompressionTypeLossy;
+    desc.resourceOptions = (desc.resourceOptions & ~MTLResourceStorageModeMask) | MTLResourceStorageModePrivate;
+  }
+}
