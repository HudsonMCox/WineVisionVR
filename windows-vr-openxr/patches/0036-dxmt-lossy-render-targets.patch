 namespace dxmt {
 
@@ -354,6 +355,38 @@ struct SharedResourceData {
   D3DKMT_HANDLE mutex_handle;
 };
 
+// DXMT_LOSSY_RENDER_TARGETS=1 opts plain color render targets into Metal lossy texture compression, read once
+static bool LossyRenderTargetsEnabled() {
+  static const bool enabled = env::getEnvVar("DXMT_LOSSY_RENDER_TARGETS") == "1";
+  return enabled;
+}
+
+// Only single-sampled, single-slice Texture2D render targets without UAV, depth, CPU access or misc flags.
+// The format list has no TYPELESS or sRGB entries, and a texture that needs a pixel format view is refused,
+// so DXMT never creates a typed view of a different format for a texture that gets compressed.
+static bool IsLossyRenderTargetCandidate(const D3D11_TEXTURE2D_DESC1 &desc, const WMTTextureInfo &info) {
+  if (!(desc.BindFlags & D3D11_BIND_RENDER_TARGET))
+    return false;
+  if (desc.BindFlags & (D3D11_BIND_UNORDERED_ACCESS | D3D11_BIND_DEPTH_STENCIL))
+    return false;
+  if (desc.Usage != D3D11_USAGE_DEFAULT || desc.CPUAccessFlags != 0 || desc.MiscFlags != 0)
+    return false;
+  if (info.type != WMTTextureType2D || info.sample_count != 1 || info.array_length != 1)
+    return false;
+  if (info.usage & WMTTextureUsagePixelFormatView)
+    return false;
+  switch (desc.Format) {
+  case DXGI_FORMAT_R8G8B8A8_UNORM:
+  case DXGI_FORMAT_B8G8R8A8_UNORM:
+  case DXGI_FORMAT_R16G16B16A16_FLOAT:
+  case DXGI_FORMAT_R11G11B10_FLOAT:
+  case DXGI_FORMAT_R10G10B10A2_UNORM:
+    return true;
+  default:
+    return false;
+  }
+}
