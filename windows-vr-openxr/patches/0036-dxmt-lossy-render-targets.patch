 HRESULT CreateDeviceTextureInternal(MTLD3D11Device *pDevice,
                                     const typename tag::DESC1 *pDesc,
@@ -366,15 +399,6 @@ HRESULT CreateDeviceTextureInternal(MTLD3D11Device *pDevice,
   }
   bool single_subresource = info.mipmap_level_count == 1 && info.array_length == 1 &&
                             !(finalDesc.MiscFlags & D3D11_RESOURCE_MISC_TEXTURECUBE);
-  auto texture = Rc<Texture>(new Texture(info, pDevice->GetMTLDevice()));
-  // Nothing can sample or copy from it, so a pass that is fully overwritten by the next one may skip its store.
-  // Memoryless storage is not used, as contents must survive pass boundaries when a later pass reads them.
-  texture->transient_attachment =
-      ((finalDesc.BindFlags & (D3D11_BIND_RENDER_TARGET | D3D11_BIND_DEPTH_STENCIL)) != 0) &&
-      (info.sample_count > 1 || (finalDesc.BindFlags & D3D11_BIND_DEPTH_STENCIL)) &&
-      ((finalDesc.BindFlags & (D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS)) == 0) &&
-      finalDesc.Usage == D3D11_USAGE_DEFAULT && finalDesc.CPUAccessFlags == 0 && finalDesc.MiscFlags == 0;
-
   // stereo eye candidate: a default 2D target that may become one slice of a shared 2-slice parent
   // every creation goes through the claim so that a pending partner only survives the next identical creation
   const bool eyeEligible =
@@ -384,6 +408,22 @@ HRESULT CreateDeviceTextureInternal(MTLD3D11Device *pDevice,
   std::shared_ptr<EyeTextureBacking> eyeBacking;
   uint32_t eyeSlice = 0;
   const bool eyeClaimed = pDevice->ClaimEyeTextureBacking(info, eyeEligible, &eyeBacking, &eyeSlice);
+
+  // opt-in lossy compression for plain color render targets, decided before the texture is created
+  if constexpr (std::is_same_v<typename tag::DESC1, D3D11_TEXTURE2D_DESC1>) {
+    if (!eyeClaimed && LossyRenderTargetsEnabled() && IsLossyRenderTargetCandidate(finalDesc, info))
+      info.compression = 1;
+  }
+
+  auto texture = Rc<Texture>(new Texture(info, pDevice->GetMTLDevice()));
+  // Nothing can sample or copy from it, so a pass that is fully overwritten by the next one may skip its store.
+  // Memoryless storage is not used, as contents must survive pass boundaries when a later pass reads them.
+  texture->transient_attachment =
+      ((finalDesc.BindFlags & (D3D11_BIND_RENDER_TARGET | D3D11_BIND_DEPTH_STENCIL)) != 0) &&
+      (info.sample_count > 1 || (finalDesc.BindFlags & D3D11_BIND_DEPTH_STENCIL)) &&
+      ((finalDesc.BindFlags & (D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS)) == 0) &&
+      finalDesc.Usage == D3D11_USAGE_DEFAULT && finalDesc.CPUAccessFlags == 0 && finalDesc.MiscFlags == 0;
+
   if (eyeClaimed)
     texture->setEyeBacking(eyeBacking, eyeSlice);
 
