 constexpr uint32_t kCommandChunkCount = 32;
 
+// Query polling stays within the guest instead of crossing the native
+// Metal bridge on every GetData call. Only real completed command chunks
+// publish progress; this fence never predicts GPU completion.
+class CompletedEventFence {
+  std::atomic<uint64_t> completed_{0};
+public:
+  void retire(uint64_t sequence, bool gpuCompleted) {
+    if (gpuCompleted) completed_.store(sequence, std::memory_order_release);
+  }
+  uint64_t signaledValue() const {
+    return completed_.load(std::memory_order_acquire);
+  }
+};
