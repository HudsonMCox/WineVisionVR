+static bool
+TileStoreElisionExtEnabled() {
+  static const bool enabled = [] {
+    bool val = env::getEnvVar("DXMT_TILE_STORE_ELISION_EXT") == "1";
+    WARN("DXMT_TILE_STORE_ELISION_EXT=", val ? "1" : "0");
+    return val;
+  }();
+  return enabled;
+}
