+// true if `next` overwrites the whole depth attachment before anything can read it
+static bool
+isNextPassOverwritingDepth(const RenderEncoderDepthAttachmentData &depth, EncoderData *next) {
+  if (!next || !depth.attachment.ptr() || depth.depth_plane != 0)
+    return false;
+  if (next->type == EncoderType::Clear) {
+    auto clear = static_cast<ClearEncoderData *>(next);
+    if (clear->clear_dsv == 0 || clear->attachment.ptr() != depth.attachment.ptr())
+      return false;
+    auto texture = depth.attachment->allocation->descriptor;
+    auto planar_flags = DepthStencilPlanarFlags(texture->pixelFormat());
+    unsigned required_flags = 1;
+    if (planar_flags & 2)
+      required_flags |= 2;
+    return (clear->clear_dsv & required_flags) == required_flags;
+  }
+  if (next->type == EncoderType::Render) {
+    auto render = static_cast<RenderEncoderData *>(next);
+    if (render->depth.attachment.ptr() != depth.attachment.ptr())
+      return false;
+    return render->depth.depth_plane == 0 &&
+           (render->depth.load_action == WMTLoadActionClear || render->depth.load_action == WMTLoadActionDontCare);
+  }
+  return false;
+}
+
+// true if `next` overwrites the whole stencil attachment before anything can read it
+static bool
+isNextPassOverwritingStencil(const RenderEncoderStencilAttachmentData &stencil, EncoderData *next) {
+  if (!next || !stencil.attachment.ptr() || stencil.depth_plane != 0)
+    return false;
+  if (next->type == EncoderType::Clear) {
+    auto clear = static_cast<ClearEncoderData *>(next);
+    if (clear->clear_dsv == 0 || clear->attachment.ptr() != stencil.attachment.ptr())
+      return false;
+    auto texture = stencil.attachment->allocation->descriptor;
+    auto planar_flags = DepthStencilPlanarFlags(texture->pixelFormat());
+    unsigned required_flags = 2;
+    if (planar_flags & 1)
+      required_flags |= 1;
+    return (clear->clear_dsv & required_flags) == required_flags;
+  }
+  if (next->type == EncoderType::Render) {
+    auto render = static_cast<RenderEncoderData *>(next);
+    if (render->stencil.attachment.ptr() != stencil.attachment.ptr())
+      return false;
+    return render->stencil.depth_plane == 0 &&
+           (render->stencil.load_action == WMTLoadActionClear || render->stencil.load_action == WMTLoadActionDontCare);
+  }
+  return false;
+}
