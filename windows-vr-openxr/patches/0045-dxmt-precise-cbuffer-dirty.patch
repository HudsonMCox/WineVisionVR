+// Dirty only the constant-buffer slots that bind a renamed buffer instead of every slot of
+// every stage, so unrelated stages' tables are not re-encoded after each per-object update.
+static bool
+PreciseCBufferDirtyEnabled() {
+  static const bool enabled = [] {
+    bool val = env::getEnvVar("DXMT_PRECISE_CBUFFER_DIRTY") == "1";
+    WARN("DXMT_PRECISE_CBUFFER_DIRTY=", val ? "1" : "0");
+    return val;
+  }();
+  return enabled;
+}
