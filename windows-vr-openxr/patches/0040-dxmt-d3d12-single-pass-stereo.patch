+// size of the command allocator GPU heap that pass argument table offsets point into
+constexpr uint64_t kStereoGPUHeapLimit = 0x400000u;
+
+enum class StereoFallback : unsigned {
+  NoNextPass,
+  Blocked,
+  Attachments,
+  Commands,
+  NoStereoPipeline,
+  Count,
+};
+
+constexpr const char *kStereoFallbackNames[] = {
+    "next encoder is not a render pass", "pass uses commands the merged pass cannot replay",
+    "attachments are not the two layers of one target", "command streams differ", "no stereo pipeline variant",
+};
+
+static std::atomic_uint64_t stereo_pass_merged{0};
+static std::atomic_uint64_t stereo_pass_fallback{0};
+
+inline void
+NoteStereoMerged() {
+  auto count = stereo_pass_merged.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (count == 1 || (count >= 1024 && (count & (count - 1)) == 0))
+    WARN("wvr-stereo d3d12 stereo_pass_merged=", count, " stereo_pass_fallback=", stereo_pass_fallback.load());
+}
+
+inline void
+NoteStereoFallback(StereoFallback reason, const char *detail) {
+  static std::atomic_bool logged[unsigned(StereoFallback::Count)];
+  auto count = stereo_pass_fallback.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (!logged[unsigned(reason)].exchange(true))
+    WARN("wvr-stereo d3d12 fallback: ", kStereoFallbackNames[unsigned(reason)], " (", detail, ") stereo_pass_merged=",
+         stereo_pass_merged.load(), " stereo_pass_fallback=", count);
+}
+
+/**
+Builds the command list of one pass that renders both eyes with vertex amplification from two consecutive layered
+eye passes (a renders slice 0, b renders slice 1). Only succeeds when both passes are provably the same work apart from
+the root arguments, which eye 1 receives at SM50_BINDING_INDEX_ROOT_ARGUMENTS_EYE1. Nothing is modified on failure.
+*/
+class StereoPassBuilder {
+  std::vector<std::unique_ptr<uint64_t[]>> blocks_;
+  wmtcmd_render_nop head_{};
+  wmtcmd_base *tail_ = nullptr;
+
+  static size_t
+  CommandSize(uint16_t type) {
+    switch (type) {
+    case WMTRenderCommandSetVertexBuffer:
+    case WMTRenderCommandSetFragmentBuffer:
+      return sizeof(wmtcmd_render_setbuffer);
+    case WMTRenderCommandSetPSO:
+      return sizeof(wmtcmd_render_setpso);
+    case WMTRenderCommandSetDepthStencilState:
+      return sizeof(wmtcmd_render_setdepthstencilstate);
+    case WMTRenderCommandSetRasterizerState:
+      return sizeof(wmtcmd_render_setrasterizerstate);
+    case WMTRenderCommandSetViewports:
+      return sizeof(wmtcmd_render_setviewports);
+    case WMTRenderCommandSetScissorRects:
+      return sizeof(wmtcmd_render_setscissorrects);
+    case WMTRenderCommandSetBlendFactor:
+      return sizeof(wmtcmd_render_setblendcolor);
+    case WMTRenderCommandSetStencilRef:
+      return sizeof(wmtcmd_render_setstencilref);
+    case WMTRenderCommandDraw:
+      return sizeof(wmtcmd_render_draw);
+    case WMTRenderCommandDrawIndexed:
+      return sizeof(wmtcmd_render_draw_indexed);
+    default:
+      return 0;
+    }
+  }
+
+  wmtcmd_base *
+  Allocate(size_t size) {
+    blocks_.emplace_back(new uint64_t[(size + 7) / 8]());
+    return reinterpret_cast<wmtcmd_base *>(blocks_.back().get());
+  }
+
+  wmtcmd_base *
+  Clone(wmtcmd_base *src, size_t size) {
+    auto dst = Allocate(size);
+    std::memcpy((void *)dst, (void *)src, size);
+    dst->next.set(nullptr);
+    return dst;
+  }
+
+  void
+  Append(wmtcmd_base *cmd) {
+    tail_->next.set(cmd);
+    tail_ = cmd;
+  }
+
+  static bool
+  SameAttachment(const TextureViewRef &a, const TextureViewRef &b) {
+    // the same allocation of one texture, a on slice 0 and b on slice 1 of the same level and format
+    if (!a || !b || a.ptr()->allocation != b.ptr()->allocation)
+      return false;
+    auto texture = a.ptr()->allocation->descriptor;
+    auto ka = a.ptr()->key;
+    auto kb = b.ptr()->key;
+    if (ka.array_start != 0 || ka.array_end != 1 || kb.array_start != 1 || kb.array_end != 2)
+      return false;
+    if (ka.mip_start != kb.mip_start || ka.mip_end != kb.mip_end)
+      return false;
+    return texture->pixelFormat(ka) == texture->pixelFormat(kb);
+  }
+
+  // compares the bytes of an argument table that both passes wrote into the GPU heap of their allocator
+  static bool
+  SameTable(RenderEncoderData *a, wmtcmd_render_setbuffer *ca, RenderEncoderData *b, wmtcmd_render_setbuffer *cb) {
+    if (!ca->table_size_known || !cb->table_size_known || ca->table_size != cb->table_size)
+      return false;
+    if (!ca->table_size)
+      return true;
+    if (!a->gpu_heap_mapping || !b->gpu_heap_mapping)
+      return false;
+    if (ca->offset + ca->table_size > kStereoGPUHeapLimit || cb->offset + cb->table_size > kStereoGPUHeapLimit)
+      return false;
+    return std::memcmp(a->gpu_heap_mapping + ca->offset, b->gpu_heap_mapping + cb->offset, ca->table_size) == 0;
+  }
+
+public:
+  wmtcmd_render_nop *
+  Build(RenderEncoderData *a, RenderEncoderData *b, StereoFallback &reason, const char *&detail) {
+    reason = StereoFallback::Blocked;
+    detail = "";
+    if (a->stereo_blocked || b->stereo_blocked || !a->stereo_candidate) {
+      detail = a->stereo_blocked || b->stereo_blocked ? "indirect draw" : "not a layered slice 0 target";
+      return nullptr;
+    }
+    if (a->use_visibility_result || b->use_visibility_result || a->use_tessellation || b->use_tessellation ||
+        a->use_geometry || b->use_geometry) {
+      detail = "visibility, tessellation or geometry";
+      return nullptr;
+    }
+
+    reason = StereoFallback::Attachments;
+    if (a->render_target_array_length > 1 || b->render_target_array_length > 1 ||
+        a->render_target_count != b->render_target_count ||
+        a->default_raster_sample_count != b->default_raster_sample_count ||
+        a->render_target_width != b->render_target_width || a->render_target_height != b->render_target_height ||
+        a->dsv_planar_flags != b->dsv_planar_flags || a->dsv_readonly_flags != b->dsv_readonly_flags) {
+      detail = "pass shape";
+      return nullptr;
+    }
+    for (unsigned i = 0; i < a->colors.size(); i++) {
+      auto &ca = a->colors[i];
+      auto &cb = b->colors[i];
+      if (!ca.attachment && !cb.attachment)
+        continue;
+      if (!SameAttachment(ca.attachment, cb.attachment) || !a->stereo_color_views[i]) {
+        detail = "colour target";
+        return nullptr;
+      }
+      if (ca.level || cb.level || ca.depth_plane || cb.depth_plane || ca.resolve_attachment || cb.resolve_attachment ||
+          ca.store_action != cb.store_action || ca.store_action != WMTStoreActionStore ||
+          ca.load_action != cb.load_action) {
+        detail = "colour actions";
