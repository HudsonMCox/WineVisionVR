     /// tell "still working" from "wedged".
+    private var preparedArenas: Set<UInt> = []
     private var lastScriptActivity: Date = .distantPast
     private let activityLock = NSLock()
+
+    func hasPreparedArena(for proxy: OpaquePointer) -> Bool {
+        activityLock.lock()
+        defer { activityLock.unlock() }
+        return preparedArenas.contains(UInt(bitPattern: proxy))
+    }
+
+    func markArenaPrepared(for proxy: OpaquePointer) {
+        activityLock.lock()
+        preparedArenas.insert(UInt(bitPattern: proxy))
+        activityLock.unlock()
+    }
+
+    func clearPreparedArena(for proxy: OpaquePointer) {
+        activityLock.lock()
+        preparedArenas.remove(UInt(bitPattern: proxy))
+        activityLock.unlock()
+    }
 
