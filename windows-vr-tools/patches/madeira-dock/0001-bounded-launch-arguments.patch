+/* Optional application arguments are bounded and never written to reports. */
+static bool read_launch_args(char *text, DWORD capacity)
+{
+    if (!text || !capacity) return false;
+    text[0] = 0;
+    SetLastError(ERROR_SUCCESS);
+    DWORD length = GetEnvironmentVariableA("MADEIRA_STEAM_HOST_EXTRA_ARGS", text, capacity);
+    if (length) return length < capacity;
+    DWORD error = GetLastError();
+    return error == ERROR_SUCCESS || error == ERROR_ENVVAR_NOT_FOUND;
 }
 
