+#ifdef __MINGW32__
+// Trace the loader boundary before CRT construction. Forward every reason and
+// argument unchanged to the real startup routine; do not initialize globals
+// manually or bypass detach/thread notifications.
+extern "C" BOOL WINAPI DllMainCRTStartup(HINSTANCE, DWORD, LPVOID);
+extern "C" BOOL WINAPI WVRDllMainCRTStartup(HINSTANCE module, DWORD reason, LPVOID reserved) {
+    wvr_log_construction_marker(reason == DLL_PROCESS_ATTACH ?
+        "[wvr-cxx-init] CRT entry process attach\n" :
+        "[wvr-cxx-init] CRT entry other notification\n");
+    BOOL result = DllMainCRTStartup(module, reason, reserved);
+    wvr_log_construction_marker(result ?
+        "[wvr-cxx-init] CRT startup returned success\n" :
+        "[wvr-cxx-init] CRT startup returned failure\n");
+    return result;
+}
+#endif
