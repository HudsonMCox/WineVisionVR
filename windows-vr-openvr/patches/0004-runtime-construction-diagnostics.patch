+// Avoid dependence on C++ streams or the guest CRT stderr handle while
+// diagnosing DLL construction. No dynamically initialized storage is used.
+void wvr_log_construction_marker(const char *message) {
+#ifdef _WIN32
+    HANDLE file = CreateFileW(L"C:\\windows-vr-runtime\\opencomposite-init.txt",
+        FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+        OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return;
+    DWORD written = 0;
+    WriteFile(file, message, static_cast<DWORD>(strlen(message)), &written, nullptr);
+    CloseHandle(file);
+#endif
+}
+static std::atomic<unsigned> stream_constructor_phase{0};
+struct StreamConstructorBefore {
+    StreamConstructorBefore() {
+        stream_constructor_phase = 1;
+        wvr_log_construction_marker("[wvr-cxx-init] logging TU entered before stream construction\n");
+    }
+};
+static StreamConstructorBefore stream_before;
 static std::ofstream stream;
+struct StreamConstructorAfter {
+    StreamConstructorAfter() {
+        stream_constructor_phase = 2;
+        wvr_log_construction_marker("[wvr-cxx-init] logging stream constructed\n");
+    }
+};
+static StreamConstructorAfter stream_after;
+static std::atomic<bool> stream_diagnostic_written{false};
 
 #ifdef __GLIBCXX__
 #include <ext/stdio_filebuf.h>
@@ -164,6 +193,14 @@
 
