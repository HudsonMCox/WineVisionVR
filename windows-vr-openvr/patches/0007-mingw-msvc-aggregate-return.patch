 cflag_spec = re.compile(r"\[(?P<name>\w+)\]\s*=\s*(?P<value>.*)")
 
 
+# These OpenVR POD returns use a hidden result pointer on Windows x64.
+# MSVC member calls put this in RCX and result in RDX; MinGW reverses them.
+_MS_SRET_TYPES = {"HmdMatrix34_t", "HmdMatrix44_t", "DistortionCoordinates_t",
+                  "HiddenAreaMesh_t", "HmdColor_t"}
+
+
+def _ms_sret_functions(iface):
+    return [(n, f) for n, f in enumerate(iface.functions)
+            if f.return_type.split("::")[-1] in _MS_SRET_TYPES]
+
+
+def _write_msabi_thunks(fi, ver):
+    functions = _ms_sret_functions(ver)
+    if not functions:
+        return
+    cname = ver.proxy_class_name()
+    fi.write("#if defined(__MINGW32__) && defined(__x86_64__)\n")
+    for n, f in functions:
+        args = (", " + f.args_str()) if f.args_str() else ""
+        fi.write(f"static {f.return_type} *msabi_{cname}_{n}({cname} *self, {f.return_type} *result{args}) {{\n"
+                 f"  static_assert(sizeof({f.return_type}) > 8, \"Expected an indirect Windows x64 return\");\n"
+                 f"  *result = self->{cname}::{f.name}({f.args_names()});\n"
+                 "  return result;\n}\n")
+    fi.write(f"void {cname}::_PrepareMSABI() {{\n"
+             "  if (_nativeVTable) return;\n"
+             "  void **original = *reinterpret_cast<void***>(this);\n"
+             "  _nativeVTable = original;\n"
+             f"  for (unsigned n = 0; n < {len(ver.functions)}; ++n) _msVTable[n] = original[n];\n")
+    for n, f in functions:
+        fi.write(f"  _msVTable[{n}] = reinterpret_cast<void*>(&msabi_{cname}_{n});\n")
+    fi.write("  *reinterpret_cast<void***>(this) = _msVTable;\n}\n#endif\n")
+
+
+def _write_deleter(fi, ver):
+    cname = ver.proxy_class_name()
+    fi.write(f"void {cname}::Delete() {{\n")
+    if _ms_sret_functions(ver):
+        fi.write("#if defined(__MINGW32__) && defined(__x86_64__)\n"
+                 "  // delete uses the complete derived vtable, including its destructor.\n"
+                 "  // The outward table intentionally contains only OpenVR API slots.\n"
+                 "  if (_nativeVTable) *reinterpret_cast<void***>(this) = _nativeVTable;\n"
+                 "#endif\n")
+    fi.write("  delete this;\n}\n")
+
+
