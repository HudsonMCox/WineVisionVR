+static wstring GetAppSettingsPath();
+
+// The runtime DLL may live in a signed, read-only app bundle. Mutable
+// application discovery/manifest state belongs to the user's Wine profile.
+static wstring GetOpenCompositeStatePath()
+{
+    const auto directory = std::filesystem::path(GetAppSettingsPath()) / L"OpenComposite";
+    std::error_code error;
+    std::filesystem::create_directories(directory, error);
+    if (error) {
+        OOVR_ABORTF("Failed to create OpenComposite state directory: %s", error.message().c_str());
+    }
+    return directory.wstring() + std::wstring(1, static_cast<wchar_t>(std::filesystem::path::preferred_separator));
+}
