new file mode 100644
index 0000000..160bdd2
--- /dev/null
+++ b/OpenOVR/Compositor/WVRTextureBounds.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <cmath>
+#include <cstring>
+
+// Matches the HLSL float4 at b0. Signed extent is deliberately retained for
+// GPU inversion; submitted OpenXR rectangles remain positive and eye-local.
+struct WVRBoundsUniform { float originX, originY, extentX, extentY; };
+static_assert(sizeof(WVRBoundsUniform) == 16);
+inline bool WVRMakeBoundsUniform(float uMin, float uMax, float vMin, float vMax,
+                                WVRBoundsUniform& out)
+{
+    if (!std::isfinite(uMin) || !std::isfinite(uMax) ||
+        !std::isfinite(vMin) || !std::isfinite(vMax) ||
+        uMin < 0 || uMin > 1 || uMax < 0 || uMax > 1 ||
+        vMin < 0 || vMin > 1 || vMax < 0 || vMax > 1 ||
+        uMin == uMax || vMin == vMax) return false;
+    out = {uMin, vMin, uMax - uMin, vMax - vMin};
+    return true;
+}
+
+// Resolver allocation depends on the full source, not only its eye crop.
+template<class Desc> inline bool WVRSameSourceShape(const Desc& a, const Desc& b)
+{
+    return a.Width == b.Width && a.Height == b.Height &&
+        a.ArraySize == b.ArraySize && a.MipLevels == b.MipLevels &&
+        a.Format == b.Format && a.SampleDesc.Count == b.SampleDesc.Count &&
+        a.SampleDesc.Quality == b.SampleDesc.Quality;
+}
