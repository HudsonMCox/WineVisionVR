+bool DX11Compositor::InvertBoundsInCompositor(const vr::VRTextureBounds_t* bounds) const
+{
+	// OpenXR image rectangles cannot encode OpenVR's negative-height bounds.
+	return Compositor::InvertBoundsInCompositor(bounds) ||
+	    (bounds && bounds->vMin > bounds->vMax);
+}
