diff --git a/OpenOVR/Misc/Win64ReturnABI.h b/OpenOVR/Misc/Win64ReturnABI.h
new file mode 100644
index 0000000..98106b9
--- /dev/null
+++ b/OpenOVR/Misc/Win64ReturnABI.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <type_traits>
+
+// LLVM-MinGW uses Itanium C++ aggregate-return ordering: result, this, args.
+// Windows OpenVR clients built with MSVC use: this, result, args. Keep the
+// internal ABI unchanged and adapt only exported primary interface vtables.
+template<typename R, typename C, typename... A, typename F>
+void WVRPatchReturn(void*& slot, R(C::*)(A...), F thunk) {
+    if constexpr (std::is_class_v<R>) {
+        // OpenVR's value types are standard-layout, trivially-copyable PODs.
+        // Win64 returns 1/2/4/8-byte PODs in RAX and larger records indirectly.
+        static_assert(std::is_standard_layout_v<R> && std::is_trivially_copyable_v<R>,
+                      "Review non-POD OpenVR return ABI before exposing it");
+        if constexpr (sizeof(R) != 1 && sizeof(R) != 2 && sizeof(R) != 4 && sizeof(R) != 8) {
+            using Bridge = R*(*)(C*, R*, A...);
+            slot = reinterpret_cast<void*>(static_cast<Bridge>(thunk));
+        }
+    }
+}
