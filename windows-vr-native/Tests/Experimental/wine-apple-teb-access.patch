@@ -2574,6 +2574,14 @@
 {
     return (struct _TEB *)__readfsdword( 0x18 );
 }
+#elif (defined(__aarch64__) || defined(__arm64ec__)) && defined(MADEIRA_APPLE_TEB)
+/* Darwin owns x18. All Wine C callers obtain the TEB through the same
+ * ntdll helper, including address arithmetic that cannot fault at x18. */
+NTSYSAPI struct _TEB * WINAPI __wine_ios_current_teb(void);
+static FORCEINLINE struct _TEB * WINAPI NtCurrentTeb(void)
+{
+    return __wine_ios_current_teb();
+}
 #elif (defined(__aarch64__) || defined(__arm64ec__)) && defined(__GNUC__)
 register struct _TEB *__wine_current_teb __asm__("x18");
