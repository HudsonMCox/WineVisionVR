--- a/wine/dlls/ntdll/thread.c
+++ b/wine/dlls/ntdll/thread.c
@@ -37,6 +37,23 @@
 
 struct _KUSER_SHARED_DATA *user_shared_data = (void *)0x7ffe0000;
 
+#if defined(__aarch64__) || defined(__arm64ec__)
+TEB * WINAPI __wine_ios_current_teb(void)
+{
+#ifdef MADEIRA_APPLE_TEB
+    extern unsigned int ios_teb_tsd_offset;
+    ULONG_PTR base;
+    __asm__ volatile("mrs %0, TPIDRRO_EL0" : "=r"(base));
+    /* The unix loader publishes the actual pthread TSD slot before PE entry.
+     * Never hard-code a slot or recover it from Darwin's reserved x18. */
+    if (!ios_teb_tsd_offset) return NULL;
+    return *(TEB **)((base & ~(ULONG_PTR)7) + ios_teb_tsd_offset);
+#else
+    return NtCurrentTeb();
+#endif
+}
+#endif
